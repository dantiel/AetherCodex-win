<Window x:Class="AetherCodex.GoToFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go to File" Height="440" Width="560"
        WindowStyle="ToolWindow" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource Foreground}">
    <DockPanel Margin="10">
        <TextBox x:Name="Query" DockPanel.Dock="Top" Padding="6,4" FontSize="14"
                 PreviewKeyDown="OnQueryKeyDown" TextChanged="OnQueryChanged"/>
        <ListBox x:Name="Results" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                 MouseDoubleClick="OnResultDoubleClick"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" Width="18" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="{Binding Display}" Foreground="{DynamicResource Foreground}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
