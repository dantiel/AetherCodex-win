<Window x:Class="AetherCodex.GoToFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go to File" Height="440" Width="560"
        WindowStyle="ToolWindow" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource Foreground}">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <TextBox x:Name="Query" Padding="6,4" FontSize="14" BorderThickness="0" Background="Transparent"
                         PreviewKeyDown="OnQueryKeyDown" TextChanged="OnQueryChanged"/>
                <TextBlock x:Name="Hint" Text="Search project files…" Margin="7,0,0,0"
                           Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <TextBlock x:Name="ScopeText" DockPanel.Dock="Bottom" FontSize="10"
                   Foreground="{DynamicResource MutedForeground}" Margin="2,6,2,0"
                   TextTrimming="CharacterEllipsis"/>
        <ListBox x:Name="Results" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                 MouseDoubleClick="OnResultDoubleClick"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" Width="18" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="{Binding Display}" Foreground="{DynamicResource Foreground}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>