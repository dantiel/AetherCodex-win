<Window x:Class="AetherCodex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:panels="clr-namespace:AetherCodex.Panels"
        Title="ÆtherCodex" Height="860" Width="1380"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource MenuBackground}" Foreground="{DynamicResource MenuForeground}">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Folder…" Click="OnOpenFolder"/>
                <MenuItem Header="Open _File…" Click="OnOpenFile"/>
                <MenuItem Header="_Go to File…" InputGestureText="Ctrl+P" Click="OnGoToFile"/>
                <Separator/>
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="OnSave"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Æther _Debug Window" Click="OnShowDebug"/>
            </MenuItem>
            <MenuItem x:Name="ThemeMenu" Header="_Theme"/>
            <MenuItem Header="_Oracle">
                <MenuItem Header="_Start / Restart daemon" Click="OnRestartDaemon"/>
                <MenuItem Header="S_top daemon" Click="OnStopDaemon"/>
                <MenuItem Header="_Interrupt" Click="OnInterrupt"/>
            </MenuItem>
        </Menu>

        <!-- Main body -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="140"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="400" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <panels:FileBrowser x:Name="Browser" Grid.Column="0"/>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Border}"/>

            <!-- Editor pane -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Padding="10,6" Background="{DynamicResource ChromeBackground}">
                    <DockPanel>
                        <TextBlock x:Name="FilePathText" DockPanel.Dock="Left" Foreground="{DynamicResource MutedForeground}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="11" Text="no file open"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="PreviewButton" DockPanel.Dock="Right" Content="◉ Preview" Style="{StaticResource IconButton}"
                                ToolTip="Toggle markdown preview" Click="OnTogglePreview" Margin="8,0,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="LanguageText" DockPanel.Dock="Right" Foreground="{DynamicResource Accent}"
                                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </DockPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="EditorColumn" Width="*"/>
                        <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0"/>
                        <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <avalonedit:TextEditor x:Name="Editor" Grid.Column="0"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="14"
                                           ShowLineNumbers="True"
                                           Background="{DynamicResource EditorBackground}"
                                           Foreground="{DynamicResource Foreground}"
                                           LineNumbersForeground="{DynamicResource MutedForeground}"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"/>
                    <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource Border}" Visibility="Collapsed"/>
                    <FlowDocumentScrollViewer x:Name="Preview" Grid.Column="2" Visibility="Collapsed"
                                              Background="{DynamicResource WindowBackground}"
                                              Padding="12"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Border}"/>

            <panels:PythiaPanel x:Name="Pythia" Grid.Column="4"/>
        </Grid>
    </DockPanel>
</Window>
