<Window x:Class="AetherCodex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:panels="clr-namespace:AetherCodex.Panels"
        xmlns:editor="clr-namespace:AetherCodex.Editor"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ÆtherCodex" Height="860" Width="1380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="160"/>
            <ColumnDefinition x:Name="SidebarSplitterColumn" Width="6"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition x:Name="PythiaSplitterColumn" Width="6"/>
            <ColumnDefinition x:Name="PythiaColumn" Width="400" MinWidth="240"/>
        </Grid.ColumnDefinitions>

        <!-- ── Full-height activity rail ── -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="RailSymbolText" Text="✦" FontSize="17" Foreground="{DynamicResource AccentBright}"
                               HorizontalAlignment="Center" Margin="0,10,0,10" ToolTip="Application sigil"/>
                    <ToggleButton x:Name="ExplorerRail" Style="{StaticResource RailToggle}" IsChecked="True"
                                  ToolTip="Explorer (Ctrl+B)" Click="OnToggleSidebar">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="16"/>
                    </ToggleButton>
                    <Button Style="{StaticResource RailAction}" ToolTip="Go to File (Ctrl+P)" Click="OnGoToFile">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource RailAction}" ToolTip="Find in Project (Ctrl+Shift+F)" Click="OnFindInProject">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71E;" FontSize="16"/>
                    </Button>
                    <ToggleButton x:Name="OracleRail" Style="{StaticResource RailToggle}" IsChecked="True"
                                  ToolTip="Oracle (Ctrl+J)" Click="OnTogglePythia">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE99A;" FontSize="16"/>
                    </ToggleButton>
                    <Button Style="{StaticResource RailAction}" ToolTip="Debug (Ctrl+Shift+D)" Click="OnShowDebug">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE943;" FontSize="16"/>
                    </Button>
                </StackPanel>

                <Button x:Name="OverflowButton" DockPanel.Dock="Bottom" Style="{StaticResource RailAction}"
                        ToolTip="Menu" Click="OpenOverflowMenu">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE712;" FontSize="16"/>
                </Button>

                <Button x:Name="SettingsButton" DockPanel.Dock="Bottom" Style="{StaticResource RailAction}"
                        ToolTip="Settings (Ctrl+,)" Click="OnShowSettings" Margin="0,0,0,8">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="16"/>
                </Button>
            </DockPanel>
        </Border>

        <!-- Explorer sidebar (full height) -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="{DynamicResource SidebarBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Configurable interactive project title (replaces the old EXPLORER header) -->
                <Border Grid.Row="0" Height="48" Padding="12,12,8,8"
                        MouseLeftButtonDown="DragRegion_MouseLeftButtonDown"
                        MouseMove="DragRegion_MouseMove">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Open Folder" Click="OnOpenFolder">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" FontSize="14"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Menu"
                                Click="OpenOverflowMenu" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="10"/>
                        </Button>
                        <TextBlock x:Name="WindowTitleText" Text="ÆtherCodex" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Foreground}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <panels:FileBrowser x:Name="Browser" Grid.Row="1"/>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" HorizontalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

        <!-- ── Editor titlebar (top of the middle column): toolbar + path + caption ── -->
        <Border Grid.Row="0" Grid.Column="3" Height="48" Padding="12,0,8,0" Background="{DynamicResource ChromeBackground}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="DragRegion_MouseLeftButtonDown"
                MouseMove="DragRegion_MouseMove">
            <DockPanel>
                <!-- Window controls (shown when the Pythia sidebar is collapsed) -->
                <StackPanel x:Name="EditorCaptionButtons" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="OnMinimize">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE921;" FontSize="10"/>
                    </Button>
                    <Button x:Name="EditorMaxRestoreButton" Style="{StaticResource CaptionButton}" ToolTip="Maximize" Click="OnMaximizeRestore">
                        <TextBlock x:Name="EditorMaxRestoreGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE922;" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" ToolTip="Close" Click="OnClose">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8BB;" FontSize="10"/>
                    </Button>
                </StackPanel>
                <Button x:Name="PreviewButton" DockPanel.Dock="Right" Content="◉ Preview" Style="{StaticResource IconButton}"
                        ToolTip="Toggle markdown preview" Click="OnTogglePreview" Margin="8,0,0,0" Visibility="Collapsed"/>
                <ToggleButton x:Name="SourceButton" DockPanel.Dock="Right" Content="Source" Style="{StaticResource ToolButton}"
                              ToolTip="Toggle markdown source view" Click="OnToggleSource" Margin="8,0,0,0" Visibility="Collapsed"/>
                <ComboBox x:Name="LanguageCombo" DockPanel.Dock="Right" Width="132" FontSize="11"
                          VerticalAlignment="Center" Margin="8,0,0,0" SelectionChanged="OnLanguageChanged"/>
                <DockPanel VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FileIconText" FontSize="14" Foreground="{DynamicResource Accent}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" Text="·"/>
                        <TextBlock x:Name="FileNameText" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource Foreground}" VerticalAlignment="Center"
                                   Text="no file open"/>
                    </StackPanel>
                    <TextBlock x:Name="FilePathText" Foreground="{DynamicResource MutedForeground}"
                               FontFamily="Cascadia Mono, Consolas" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Editor content -->
        <DockPanel Grid.Row="1" Grid.Column="3">
            <!-- Tab strip (below the editor titlebar; hidden until > 1 file open) -->
            <Border x:Name="TabBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource ChromeBackground}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource RailAction}" ToolTip="New File (Ctrl+N)"
                            Click="OnNewFile" Margin="0,0,6,0">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="13"/>
                    </Button>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Quick search (Go to File) overlay — bottom-docked, TextMate-style -->
            <Border x:Name="QuickSearch" DockPanel.Dock="Bottom" Visibility="Collapsed"
                    Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="10,10,10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4"
                            Background="{DynamicResource EditorBackground}">
                        <Grid>
                            <TextBox x:Name="QuickQuery" Padding="6,5" FontSize="13" BorderThickness="0"
                                     Background="Transparent" Foreground="{DynamicResource Foreground}"
                                     CaretBrush="{DynamicResource Foreground}"
                                     PreviewKeyDown="OnQuickQueryKeyDown" TextChanged="OnQuickQueryChanged"/>
                            <TextBlock x:Name="QuickHint" Text="Go to file…" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="QuickResults" Grid.Row="1" MaxHeight="240" Margin="0,8,0,0"
                             BorderThickness="0" Background="Transparent"
                             MouseDoubleClick="OnQuickResultDoubleClick"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Width="18" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="{Binding Display}" Foreground="{DynamicResource Foreground}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="*"/>
                    <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0"/>
                    <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
                </Grid.ColumnDefinitions>
                <avalonedit:TextEditor x:Name="Editor" Grid.Column="0"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="14"
                                        Background="{DynamicResource EditorBackground}"
                                        Foreground="{DynamicResource Foreground}"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Auto"/>
                <editor:RichTextEditor x:Name="RichEditor" Grid.Column="0" Visibility="Collapsed"/>
                <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource Border}" Visibility="Collapsed"/>
                <FlowDocumentScrollViewer x:Name="Preview" Grid.Column="2" Visibility="Collapsed"
                                          Background="{DynamicResource WindowBackground}"
                                          Padding="12"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
        </DockPanel>

        <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" HorizontalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

        <!-- Oracle panel -->
        <panels:PythiaPanel x:Name="Pythia" Grid.Row="0" Grid.RowSpan="2" Grid.Column="5"/>

        <!-- Floating font-size zoom indicator (Ctrl+wheel / Ctrl+± / Ctrl+0) -->
        <Popup x:Name="ZoomPopup" Placement="Center" PlacementTarget="{Binding ElementName=Editor}"
               AllowsTransparency="True" StaysOpen="True" IsHitTestVisible="True">
            <Border Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="18,10" Margin="16"
                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ZoomPercentText" Text="100%" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBright}" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  " FontSize="19" Foreground="{DynamicResource MutedForeground}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ZoomAbsoluteText" Text="14 pt" FontSize="19"
                               Foreground="{DynamicResource Foreground}" VerticalAlignment="Center"/>
                    <Button Content="Reset" Click="OnZoomReset" Cursor="Hand"
                            Margin="16,0,0,0" Padding="12,4" VerticalAlignment="Center"
                            FontSize="13" FontFamily="{DynamicResource UiFont}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>