<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AetherCodex</AssemblyName>
    <RootNamespace>AetherCodex</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Release versioning — single source of truth; tools/make_release.ps1 reads it. -->
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0-alpha</InformationalVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ruby daemon: the soul, pinned as the AetherOracle git submodule (Ruby/).
         The daemon lives in the submodule's ruby/ subdirectory; the bundled
         resources/ (themes + grammars) sit alongside it because the daemon
         resolves ../../resources/Themes relative to ruby/oracle/theme.rb. -->
    <None Include="..\..\Ruby\ruby\**\*" Link="Ruby\ruby\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Ruby\resources\**\*" Link="Ruby\resources\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Syntax grammars + queries + themes. -->
    <None Include="..\..\Resources\**\*" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>