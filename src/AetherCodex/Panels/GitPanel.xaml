<UserControl x:Class="AetherCodex.Panels.GitPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="12,6,8,2">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Refresh (F5)"
                    Click="OnRefresh">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="13"/>
            </Button>
            <TextBlock x:Name="SummaryText" Foreground="{DynamicResource MutedForeground}"
                       FontSize="11" VerticalAlignment="Center"/>
        </DockPanel>

        <ListBox x:Name="List" Grid.Row="1" BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 MouseDoubleClick="OnItemDoubleClick"
                 PreviewKeyDown="OnListKeyDown"/>
    </Grid>
</UserControl>
