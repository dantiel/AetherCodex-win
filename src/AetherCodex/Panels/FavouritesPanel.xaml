<UserControl x:Class="AetherCodex.Panels.FavouritesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AetherCodex.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Projects header + ÆtherLink re-scan -->
        <DockPanel Grid.Row="0" Margin="12,10,6,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                    ToolTip="Refresh ÆtherLink discovery" Click="OnRefresh">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="14"/>
            </Button>
            <TextBlock Text="Projects" FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource SidebarForeground}" VerticalAlignment="Center"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Groups" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding Header}" Margin="12,0,0,6" FontSize="11"
                                       Foreground="{DynamicResource MutedForeground}"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Favourite}">
                                        <Border CornerRadius="6" Padding="8,3" Cursor="Hand"
                                                MouseLeftButtonUp="OnItemOpen" ToolTip="{Binding Path}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Selection}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="12"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,2,6,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Setter Property="Fill" Value="#5A6068"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Source}" Value="aetherlink">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Online}" Value="True">
                                                                            <Setter Property="Fill" Value="#7FC97F"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SidebarForeground}"
                                                                   TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Path}" Foreground="{DynamicResource MutedForeground}"
                                                               FontSize="10" TextTrimming="CharacterEllipsis" Margin="12,1,0,0"/>
                                                </StackPanel>

                                                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                        ToolTip="{Binding ActionToolTip}" Click="OnItemAction"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ActionGlyph}" FontSize="12"
                                                               Foreground="{DynamicResource MutedForeground}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyLabel" Grid.Row="1" Foreground="{DynamicResource MutedForeground}"
                   FontSize="12" TextWrapping="Wrap" Margin="16"
                   Text="No favourites yet. Star a folder in the file tree, or add a discovered ÆtherLink project."
                   VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
    </Grid>
</UserControl>
