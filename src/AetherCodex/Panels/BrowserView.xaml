<UserControl x:Class="AetherCodex.Panels.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource EditorBackground}">
    <DockPanel>
        <!-- Address bar -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Background="{DynamicResource PanelBackground}">
            <DockPanel Margin="6,4">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" ToolTip="Back" Click="OnBack">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" FontSize="14"/>
                    </Button>
                    <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" ToolTip="Forward" Click="OnForward"
                            Margin="2,0,0,0">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72A;" FontSize="14"/>
                    </Button>
                    <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" ToolTip="Reload" Click="OnReload"
                            Margin="2,0,0,0">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="14"/>
                    </Button>
                    <Button x:Name="HomeButton" Style="{StaticResource IconButton}" ToolTip="Home" Click="OnHome"
                            Margin="2,0,0,0">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE80F;" FontSize="14"/>
                    </Button>
                </StackPanel>

                <Border Margin="8,0,0,0" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                        Background="{DynamicResource EditorBackground}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE774;" FontSize="12"
                                   Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox x:Name="AddressBox" VerticalAlignment="Center" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource Foreground}"
                                 CaretBrush="{DynamicResource Foreground}" FontSize="13"
                                 Padding="6,3" KeyDown="OnAddressKeyDown"/>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Web content + fallback overlay when the WebView2 runtime is unavailable -->
        <Grid>
            <wv2:WebView2 x:Name="WebView" />
            <TextBlock x:Name="ErrorOverlay" Visibility="Collapsed"
                       Foreground="{DynamicResource MutedForeground}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="24"/>
        </Grid>
    </DockPanel>
</UserControl>
