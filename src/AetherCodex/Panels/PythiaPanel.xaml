<UserControl x:Class="AetherCodex.Panels.PythiaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{StaticResource PanelBackground}">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="12,10" Background="{StaticResource ChromeBackground}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource MutedForeground}" VerticalAlignment="Center"/>
                    <TextBlock Margin="8,0,0,0" Text="PYTHIA" Foreground="{StaticResource Foreground}" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="InterruptButton" DockPanel.Dock="Right" Content="■" Style="{StaticResource IconButton}"
                        ToolTip="Interrupt" Click="OnInterrupt"/>
                <ItemsControl x:Name="Roster" DockPanel.Dock="Right" Margin="0,0,8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Messages -->
        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="8">
            <StackPanel x:Name="Messages"/>
        </ScrollViewer>

        <!-- Input -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}" Background="{StaticResource ChromeBackground}">
            <DockPanel Margin="8">
                <Button DockPanel.Dock="Right" Content="Send" Click="OnSend" MinWidth="64" Margin="8,0,0,0"/>
                <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="28" MaxHeight="140" PreviewKeyDown="OnInputKeyDown"
                         VerticalScrollBarVisibility="Auto" Padding="6,4"
                         ToolTip="Enter to send, Shift+Enter for newline"/>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
