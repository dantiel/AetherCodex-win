<UserControl x:Class="AetherCodex.Spreadsheet.SheetEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource EditorBackground}">
    <DockPanel>
        <!-- Formula bar -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Background="{DynamicResource PanelBackground}">
            <DockPanel Margin="6,4">
                <TextBlock x:Name="NameBox" DockPanel.Dock="Left" Width="64" VerticalAlignment="Center"
                           FontWeight="Bold" Foreground="{DynamicResource Accent}" Text="A1"/>
                <TextBox x:Name="FormulaBox" VerticalAlignment="Center" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource Foreground}"
                         CaretBrush="{DynamicResource Foreground}"
                         KeyDown="OnFormulaKeyDown"/>
            </DockPanel>
        </Border>

        <!-- Sheet grid -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,1"/>

            <ScrollViewer x:Name="HeaderScroll" Grid.Row="0" Grid.Column="1"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          ScrollChanged="OnHeaderScrollChanged">
                <Canvas x:Name="HeaderCanvas" Height="24" Background="{DynamicResource PanelBackground}"/>
            </ScrollViewer>

            <ScrollViewer x:Name="RowScroll" Grid.Row="1" Grid.Column="0"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                          ScrollChanged="OnRowScrollChanged">
                <Canvas x:Name="RowCanvas" Width="48" Background="{DynamicResource PanelBackground}"/>
            </ScrollViewer>

            <ScrollViewer x:Name="SurfaceScroll" Grid.Row="1" Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Focusable="True"
                          ScrollChanged="OnSurfaceScrollChanged"
                          PreviewMouseLeftButtonDown="OnSurfaceMouseDown"
                          PreviewKeyDown="OnSurfaceKeyDown">
                <Canvas x:Name="CellCanvas" Background="{DynamicResource EditorBackground}"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
