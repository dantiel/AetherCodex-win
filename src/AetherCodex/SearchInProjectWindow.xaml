<Window x:Class="AetherCodex.SearchInProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find in Project" Height="620" Width="820"
        WindowStyle="ToolWindow" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource Foreground}">
    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Query (editable combo = search/regex history dropdown) -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <ComboBox x:Name="Query" IsEditable="True" Padding="6,4" FontSize="14"
                              BorderThickness="0" Background="Transparent"
                              KeyDown="OnQueryKeyDown"/>
                    <TextBlock x:Name="Hint" Text="Search in project…" Margin="8,0,0,0"
                               Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Options -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox x:Name="RegexToggle" Content="Regex" VerticalAlignment="Center" Margin="0,0,12,0"
                          Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
                <CheckBox x:Name="CaseToggle" Content="Case" VerticalAlignment="Center" Margin="0,0,12,0"
                          Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
                <CheckBox x:Name="WordToggle" Content="Whole word" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"
                          Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
                <ComboBox x:Name="ScopeBox" Width="120" VerticalAlignment="Center"
                          SelectionChanged="OnScopeChanged">
                    <ComboBoxItem Content="Project"/>
                    <ComboBoxItem Content="Current File"/>
                    <ComboBoxItem Content="Folder…"/>
                </ComboBox>
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4"
                        VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBox x:Name="FileTypes" Width="240" Padding="6,3" FontSize="12"
                             BorderThickness="0" Background="Transparent"
                             ToolTip="File types: globs (*.rb, *.cs) or language names (ruby, c#, python)"
                             TextChanged="OnOptionChanged"/>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="Footer" DockPanel.Dock="Bottom" FontSize="10"
                   Foreground="{DynamicResource MutedForeground}" Margin="2,6,2,0"
                   TextTrimming="CharacterEllipsis"/>

        <ListBox x:Name="Results" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                 MouseDoubleClick="OnResultDoubleClick"
                 HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.IsVirtualizing="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" Width="20" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="{Binding Header}" Foreground="{DynamicResource Foreground}"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Snippet}" Foreground="{DynamicResource MutedForeground}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="20,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
