<Window x:Class="AetherCodex.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="600" Width="680"
        WindowStyle="ToolWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource Foreground}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="SourceBadge" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedForeground}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBackground}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0"/>
                <Button Content="Apply" IsDefault="True" MinWidth="84" Click="OnOk"/>
            </StackPanel>
        </Border>

        <TabControl TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Padding="0,4">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                        <TextBlock Text="Window title" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WindowTitleBox" Margin="0,0,0,16"
                                 ToolTip="Shown in the explorer header"/>

                        <TextBlock Text="Sigil" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="SymbolBox" Margin="0,0,0,16"
                                  ToolTip="Symbol shown at the top of the activity rail"/>

                        <TextBlock Text="Daemon" Style="{StaticResource FieldLabel}"/>
                        <CheckBox x:Name="AutoDaemonCheck" Content="Start the Ruby oracle daemon on launch"
                                  Margin="0,0,0,16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Editor">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                        <TextBlock Text="Code font" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="FontFamilyBox" IsEditable="True" Margin="0,0,0,16"/>

                        <TextBlock Text="Code font size" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="FontSizeBox" IsEditable="True" Margin="0,0,0,16"/>

                        <CheckBox x:Name="LineNumbersCheck" Content="Show line numbers" Margin="0,0,0,16"/>
                        <CheckBox x:Name="WordWrapCheck" Content="Wrap long lines instead of scrolling" Margin="0,0,0,16"/>

                        <TextBlock Text="Tab size" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="TabSizeBox" IsEditable="True" Margin="0,0,0,16"/>

                        <CheckBox x:Name="TabsToSpacesCheck" Content="Convert tabs to spaces" Margin="0,0,0,16"/>
                        <CheckBox x:Name="WhitespaceCheck" Content="Show spaces, tabs and line endings" Margin="0,0,0,16"/>
                        <CheckBox x:Name="HighlightLineCheck" Content="Highlight the active line" Margin="0,0,0,16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                        <TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ThemeBox" Margin="0,0,0,16"/>

                        <TextBlock Text="UI font" Style="{StaticResource FieldLabel}"
                                   ToolTip="Proportional face for the shell chrome and Pythia markdown prose"/>
                        <ComboBox x:Name="UiFontFamilyBox" IsEditable="True" Margin="0,0,0,16"/>

                        <TextBlock Text="UI font size" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="UiFontSizeBox" IsEditable="True" Margin="0,0,0,16"/>

                        <TextBlock Text="Transparency" Style="{StaticResource FieldLabel}"/>
                        <CheckBox x:Name="OpacityUseDefaultCheck" Content="Use theme default"
                                  Checked="OnUseDefaultOpacityChanged" Unchecked="OnUseDefaultOpacityChanged"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="OpacitySlider" Grid.Column="0" Minimum="15" Maximum="100"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center" ValueChanged="OnOpacityChanged"/>
                            <TextBlock x:Name="OpacityValueText" Grid.Column="1" MinWidth="40"
                                       TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedForeground}" Margin="12,0,0,0"/>
                        </Grid>
                        <TextBlock Text="How translucent the whole window renders. Themes may declare their own opacity; leave this on the theme default to follow it."
                                   Style="{StaticResource Hint}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="AI Provider">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                        <TextBlock Text="Provider" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="OracleProviderBox" DisplayMemberPath="Name"
                                  SelectionChanged="OnOracleProviderChanged" Margin="0,0,0,16"
                                  ToolTip="AI provider that answers the oracle's turns"/>

                        <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="OracleModelBox" IsEditable="True"
                                  SelectionChanged="OnOracleModelChanged" Margin="0,0,0,16"
                                  ToolTip="Model id — a preset for the chosen provider, or a custom id"/>

                        <TextBlock Text="API key" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="OracleKeyPassword" Grid.Column="0" VerticalContentAlignment="Center"
                                         PasswordChanged="OnOracleKeyPasswordChanged"
                                         ToolTip="The provider's API key; stored locally, never logged"/>
                            <TextBox x:Name="OracleKeyPlain" Grid.Column="0" VerticalContentAlignment="Center" Visibility="Collapsed"
                                     TextChanged="OnOracleKeyPlainChanged"/>
                            <CheckBox x:Name="ShowKeyCheck" Grid.Column="1" Content="Show" VerticalAlignment="Center"
                                      Margin="8,0,0,0" Checked="OnShowKeyChanged" Unchecked="OnShowKeyChanged"/>
                        </Grid>

                        <TextBlock Text="Endpoint" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="OracleUrlBox" Margin="0,0,0,16"
                                 ToolTip="Auto-filled from the provider; override for a proxy or custom endpoint"/>

                        <TextBlock Text="The key is stored locally in settings.json and passed to the Ruby oracle as an environment variable. Changing it restarts the daemon so the new model takes effect."
                                   Style="{StaticResource Hint}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Project">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="Config file" Style="{StaticResource FieldLabel}"/>
                        <DockPanel Margin="0,0,0,4">
                            <Button x:Name="OpenConfigButton" Content="Open" DockPanel.Dock="Right"
                                    Click="OnOpenConfig" MinWidth="64" Padding="10,2" Margin="8,0,0,0"
                                    ToolTip="Open this file in the editor (creates it if missing)"/>
                            <TextBox x:Name="ConfigPathText" IsReadOnly="True" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="ConfigFormatText" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ProjectRootText" Style="{StaticResource Hint}" Margin="0,0,0,16"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="NameSource" DockPanel.Dock="Right" Style="{StaticResource SourceBadge}"/>
                            <TextBox x:Name="NameBox" ToolTip="Context name advertised to peers; falls back to the folder name"/>
                        </DockPanel>

                        <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="ModelSource" DockPanel.Dock="Right" Style="{StaticResource SourceBadge}"/>
                            <TextBox x:Name="ModelBox" ToolTip="Model id — a preset, or a custom id"/>
                        </DockPanel>

                        <TextBlock Text="Fast model" Style="{StaticResource FieldLabel}"/>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="FastModelSource" DockPanel.Dock="Right" Style="{StaticResource SourceBadge}"/>
                            <TextBox x:Name="FastModelBox" ToolTip="Model used for quick/low-latency turns"/>
                        </DockPanel>

                        <TextBlock Text="API type" Style="{StaticResource FieldLabel}"/>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="ApiTypeSource" DockPanel.Dock="Right" Style="{StaticResource SourceBadge}"/>
                            <TextBox x:Name="ApiTypeBox" ToolTip="deepseek / openai / anthropic / gemini / custom"/>
                        </DockPanel>

                        <TextBlock Text="Endpoint" Style="{StaticResource FieldLabel}"/>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="ApiUrlSource" DockPanel.Dock="Right" Style="{StaticResource SourceBadge}"/>
                            <TextBox x:Name="ApiUrlBox" ToolTip="API endpoint; auto-derived from the model unless overridden"/>
                        </DockPanel>

                        <TextBlock Text="API key" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ProjectKeyPassword" Grid.Column="0" VerticalContentAlignment="Center"
                                         PasswordChanged="OnProjectKeyPasswordChanged"
                                         ToolTip="Provider API key for this project; inherited from home when unset"/>
                            <TextBox x:Name="ProjectKeyPlain" Grid.Column="0" VerticalContentAlignment="Center" Visibility="Collapsed"
                                     TextChanged="OnProjectKeyPlainChanged"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ProjectShowKeyCheck" Content="Show" VerticalAlignment="Center"
                                          Margin="8,0,0,0" Checked="OnProjectShowKeyChanged" Unchecked="OnProjectShowKeyChanged"/>
                                <TextBlock x:Name="ApiKeySource" Style="{StaticResource SourceBadge}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="PortSource" DockPanel.Dock="Right" Style="{StaticResource SourceBadge}"/>
                            <TextBox x:Name="PortBox" ToolTip="Daemon port (default 4567)"/>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="DevModeSource" DockPanel.Dock="Right" Style="{StaticResource SourceBadge}"/>
                            <CheckBox x:Name="DevModeCheck" Content="Developer mode (dangerous instruments)"
                                      ToolTip="Enables experimental / destructive instruments"/>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="ReasoningModelSource" DockPanel.Dock="Right" Style="{StaticResource SourceBadge}"/>
                            <CheckBox x:Name="ReasoningModelCheck" Content="Reasoning model enabled"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="RefreshConfigButton" Content="Refresh" Click="OnRefreshConfig" MinWidth="80"/>
                        </StackPanel>

                        <TextBlock x:Name="ProjectHintText" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>