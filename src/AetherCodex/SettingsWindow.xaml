<Window x:Class="AetherCodex.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="980" Width="600"
        WindowStyle="ToolWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource Foreground}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0"/>
            <Button Content="Apply" IsDefault="True" MinWidth="84" Click="OnOk"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="WINDOW"
                           Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Title" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <TextBox x:Name="WindowTitleBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"
                         ToolTip="Shown in the explorer header"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Sigil" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <ComboBox x:Name="SymbolBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12"
                          ToolTip="Symbol shown at the top of the activity rail"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="APPEARANCE"
                           Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,10"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Theme" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <ComboBox x:Name="ThemeBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="UI font" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"
                           ToolTip="Proportional face for the shell chrome and Pythia markdown prose"/>
                <ComboBox x:Name="UiFontFamilyBox" Grid.Row="5" Grid.Column="1" IsEditable="True" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="UI font size" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <ComboBox x:Name="UiFontSizeBox" Grid.Row="6" Grid.Column="1" IsEditable="True" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Text="EDITOR"
                           Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,10"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Code font size" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <ComboBox x:Name="FontSizeBox" Grid.Row="8" Grid.Column="1" IsEditable="True" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="Code font" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <ComboBox x:Name="FontFamilyBox" Grid.Row="9" Grid.Column="1" IsEditable="True" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="Line numbers" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <CheckBox x:Name="LineNumbersCheck" Grid.Row="10" Grid.Column="1" Content="Show line numbers in the editor" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="Word wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <CheckBox x:Name="WordWrapCheck" Grid.Row="11" Grid.Column="1" Content="Wrap long lines instead of scrolling" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="12" Grid.Column="0" Text="Tab size" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <ComboBox x:Name="TabSizeBox" Grid.Row="12" Grid.Column="1" IsEditable="True" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="13" Grid.Column="0" Text="Indentation" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <CheckBox x:Name="TabsToSpacesCheck" Grid.Row="13" Grid.Column="1" Content="Convert tabs to spaces" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="14" Grid.Column="0" Text="Whitespace" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <CheckBox x:Name="WhitespaceCheck" Grid.Row="14" Grid.Column="1" Content="Show spaces, tabs and line endings" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="15" Grid.Column="0" Text="Current line" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <CheckBox x:Name="HighlightLineCheck" Grid.Row="15" Grid.Column="1" Content="Highlight the active line" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2" Text="DAEMON"
                           Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,10"/>

                <TextBlock Grid.Row="17" Grid.Column="0" Text="Autostart" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <CheckBox x:Name="AutoDaemonCheck" Grid.Row="17" Grid.Column="1" Content="Start the Ruby oracle daemon on launch"/>

                <TextBlock Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2" Text="ORACLE"
                           Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,10"/>

                <TextBlock Grid.Row="19" Grid.Column="0" Text="Provider" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <ComboBox x:Name="OracleProviderBox" Grid.Row="19" Grid.Column="1" Margin="0,0,0,12"
                           DisplayMemberPath="Name" SelectionChanged="OnOracleProviderChanged"
                           ToolTip="AI provider that answers the oracle's turns"/>

                <TextBlock Grid.Row="20" Grid.Column="0" Text="Model" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <ComboBox x:Name="OracleModelBox" Grid.Row="20" Grid.Column="1" IsEditable="True" Margin="0,0,0,12"
                           SelectionChanged="OnOracleModelChanged"
                           ToolTip="Model id — a preset for the chosen provider, or a custom id"/>

                <TextBlock Grid.Row="21" Grid.Column="0" Text="API key" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <Grid Grid.Row="21" Grid.Column="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="OracleKeyPassword" Grid.Column="0" VerticalContentAlignment="Center"
                                 PasswordChanged="OnOracleKeyPasswordChanged"
                                 ToolTip="The provider's API key; stored locally, never logged"/>
                    <TextBox x:Name="OracleKeyPlain" Grid.Column="0" VerticalContentAlignment="Center" Visibility="Collapsed"
                             TextChanged="OnOracleKeyPlainChanged"/>
                    <CheckBox x:Name="ShowKeyCheck" Grid.Column="1" Content="Show" VerticalAlignment="Center"
                              Margin="8,0,0,0" Checked="OnShowKeyChanged" Unchecked="OnShowKeyChanged"/>
                </Grid>

                <TextBlock Grid.Row="22" Grid.Column="0" Text="Endpoint" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
                <TextBox x:Name="OracleUrlBox" Grid.Row="22" Grid.Column="1" Margin="0,0,0,12"
                         ToolTip="Auto-filled from the provider; override for a proxy or custom endpoint"/>

                <TextBlock Grid.Row="23" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="The key is stored locally in settings.json and passed to the Ruby oracle as an environment variable. Changing it restarts the daemon so the new model takes effect."
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" FontSize="11" Margin="0,0,0,4"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
