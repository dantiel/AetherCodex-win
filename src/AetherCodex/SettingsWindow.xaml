<Window x:Class="AetherCodex.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="760" Width="500"
        WindowStyle="ToolWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource Foreground}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0"/>
            <Button Content="Apply" IsDefault="True" MinWidth="84" Click="OnOk"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="WINDOW"
                       Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Title" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
            <TextBox x:Name="WindowTitleBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"
                     ToolTip="Shown in the explorer header"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sigil" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
            <ComboBox x:Name="SymbolBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12"
                      ToolTip="Symbol shown at the top of the activity rail"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="APPEARANCE"
                       Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,10"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Theme" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
            <ComboBox x:Name="ThemeBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="EDITOR"
                       Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,10"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Font size" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
            <ComboBox x:Name="FontSizeBox" Grid.Row="6" Grid.Column="1" IsEditable="True" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Font family" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
            <ComboBox x:Name="FontFamilyBox" Grid.Row="7" Grid.Column="1" IsEditable="True" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Line numbers" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
            <CheckBox x:Name="LineNumbersCheck" Grid.Row="8" Grid.Column="1" Content="Show line numbers in the editor" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Word wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
            <CheckBox x:Name="WordWrapCheck" Grid.Row="9" Grid.Column="1" Content="Wrap long lines instead of scrolling" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Tab size" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
            <ComboBox x:Name="TabSizeBox" Grid.Row="10" Grid.Column="1" IsEditable="True" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="11" Grid.Column="0" Text="Indentation" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
            <CheckBox x:Name="TabsToSpacesCheck" Grid.Row="11" Grid.Column="1" Content="Convert tabs to spaces" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="12" Grid.Column="0" Text="Whitespace" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
            <CheckBox x:Name="WhitespaceCheck" Grid.Row="12" Grid.Column="1" Content="Show spaces, tabs and line endings" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="13" Grid.Column="0" Text="Current line" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
            <CheckBox x:Name="HighlightLineCheck" Grid.Row="13" Grid.Column="1" Content="Highlight the active line" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2" Text="DAEMON"
                       Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,10"/>

            <TextBlock Grid.Row="15" Grid.Column="0" Text="Autostart" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}"/>
            <CheckBox x:Name="AutoDaemonCheck" Grid.Row="15" Grid.Column="1" Content="Start the Ruby oracle daemon on launch"/>
        </Grid>
    </DockPanel>
</Window>
