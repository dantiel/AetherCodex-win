<UserControl x:Class="AetherCodex.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource Foreground}">
    <DockPanel>
        <!-- ── Toolbar: title + strategy selector ── -->
        <Border DockPanel.Dock="Top" Padding="12,10,12,8"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Refresh"
                        Click="OnRefresh">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="13"/>
                </Button>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="Strategy" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource MutedForeground}" FontSize="11"/>
                    <ComboBox x:Name="StrategyBox" Width="140" VerticalAlignment="Center"
                              SelectedIndex="0" SelectionChanged="OnStrategyChanged">
                        <ComboBoxItem Content="Line"/>
                        <ComboBoxItem Content="Word"/>
                        <ComboBoxItem Content="Crepusculum"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="13"
                           FontFamily="{StaticResource MonoFont}"
                           Foreground="{DynamicResource SidebarForeground}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ── Diff rows + parallax sticky hunk header ── -->
        <Grid>
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ScrollChanged="OnScrollChanged">
                <StackPanel x:Name="Rows" Margin="0,6,0,6"/>
            </ScrollViewer>

            <!-- Pinned hunk header: floats at the top of the viewport while the
                 content scrolls beneath it (parallax push-out between hunks). -->
            <Border x:Name="StickyHeader" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    Background="{DynamicResource ChromeBackground}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    Padding="8,3" Visibility="Collapsed" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="StickyTranslate" Y="0"/>
                </Border.RenderTransform>
                <TextBlock x:Name="StickyHeaderText" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           FontWeight="Bold" Foreground="{DynamicResource SidebarForeground}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
